---
const trustSignals = [
	"25+ years of experience",
	"Danish and English",
	"At home, online and in Osterbro",
];

const featuredRecommendation = {
	text: `Maria is super professional, deeply empathetic, and a superb people person. She has an extraordinary ability to listen, guide, and create a safe space for honest conversations.`,
	author: "",
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Counselling and family guidance with Maria Baad in Osterbro, at your home or online. Support for families and practice-based programmes for institutions."
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Maria Baad | Family Guidance</title>
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<header class="site-header">
			<a class="brand" href="/en/" aria-label="Maria Baad home">
				<span class="brand-mark">MB</span>
				<span>
					<strong>Maria Baad</strong>
					<small>Family Guidance</small>
				</span>
			</a>
			<div class="header-tools">
				<nav class="main-nav" aria-label="Primary navigation">
					<a href="#families">Families</a>
					<a href="/en/testimonials">Testimonials</a>
					<a href="#about">About</a>
					<a href="#institutions">Institutions</a>
					<a href="#contact">Contact</a>
				</nav>
				<label class="language-switcher" data-language="en" aria-label="Choose language">
					<span class="sr-only">Choose language</span>
					<select name="language" onchange="if (this.value) window.location.href = this.value;">
						<option value="/">Dansk</option>
						<option value="/en/" selected>English</option>
					</select>
				</label>
			</div>
		</header>

		<main id="content">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">Family guidance in Osterbro and online</p>
					<h1 id="hero-title">Counselling and family guidance</h1>
					<p class="hero-lede">
						I help parents and families when things feel difficult, stuck, or
						overwhelming.
					</p>
					<div class="hero-actions" aria-label="Primary actions">
						<a class="button primary" href="#contact">Get in touch</a>
						<a class="button secondary" href="#families">Read more</a>
					</div>
					<ul class="trust-list" aria-label="Highlights">
						{trustSignals.map((signal) => <li>{signal}</li>)}
					</ul>
				</div>
				<div class="hero-media" aria-label="A brief introduction">
					<div class="portrait-panel">
						<img
							src="/images/maria-baad-hero.webp"
							alt="Maria Baad in a calm, bright portrait"
							width="1000"
							height="667"
						/>
					</div>
				</div>
			</section>

			<section class="section prose-section surface-section" id="families" aria-labelledby="families-title">
				<div class="section-heading">
					<p class="eyebrow">For families</p>
					<h2 id="families-title">Counselling and family guidance</h2>
				</div>
				<div class="prose-flow">
					<p>I help parents and families when things feel difficult, stuck, or overwhelming.</p>
					<p>
						Together, we try to create a deeper understanding of what lies behind a child’s reactions,
						the patterns within the family, and the situations that call for support, direction, or new
						perspectives.
					</p>
					<p>
						I meet families with warmth, honesty, and curiosity, whether it is about younger or older
						children, big emotions, conflict, distress, uncertainty in parenting, or cooperation around
						the child.
					</p>
					<p>Sessions can take place in your home, online, or from my office in Osterbro, Copenhagen.</p>
					<p>
						I offer guidance in both Danish and English and work with both Danish and international
						families.
					</p>
				</div>
			</section>

			<section class="quote-band" id="testimonials" aria-labelledby="testimonial-title">
				<div class="quote-band-head">
					<div>
						<p class="eyebrow">Testimonials</p>
						<h2 id="testimonial-title">What families say</h2>
					</div>
					<a class="quote-link" href="/en/testimonials">All testimonials</a>
				</div>
				<blockquote class="featured-quote">
					<p>{featuredRecommendation.text}</p>
					{featuredRecommendation.author && <cite>{featuredRecommendation.author}</cite>}
				</blockquote>
			</section>

			<section class="section prose-section surface-section" id="about" aria-label="About me">
				<div class="section-heading">
					<p class="eyebrow">About me</p>
				</div>
				<div class="prose-flow">
					<p>
						My name is Maria Baad Andersen, and I work as a family counsellor with children, parents, and
						families.
					</p>
					<p>
						I help families create a greater understanding of what feels difficult, whether it relates to
						wellbeing, relationships, emotions, or uncertainty in parenting.
					</p>
					<p>
						It is important to me to create a safe space where people feel seen, understood, and less alone
						in what they are going through.
					</p>
					<p>
						I have more than 25 years of experience working with children and families and draw, among
						other things, on attachment theory, mentalization, and Circle of Security.
					</p>
					<p>
						You can read more about my professional background and experience on
						<a
							class="inline-link"
							href="https://www.linkedin.com/in/maria-baad-andersen-6b454332a/"
							target="_blank"
							rel="noreferrer"
						>
							LinkedIn
						</a>
						.
					</p>
				</div>
			</section>

			<section class="section prose-section institution-section" id="institutions" aria-labelledby="institutions-title">
				<div class="section-heading">
					<p class="eyebrow">For institutions</p>
					<h2 id="institutions-title">Professional development and practice-based programmes</h2>
				</div>
				<div class="prose-flow">
					<p>
						I offer professional development, supervision, and practice-based programmes for day-care
						institutions, schools, and municipalities, based on Circle of Security and Se Barnet Indefra.
					</p>
					<p>
						With a curious and respectful approach, I help staff groups understand the child’s needs behind
						the behaviour and create shared reflection, clarity, and stronger wellbeing in everyday life.
					</p>
					<p>
						I have many years of experience working with children in vulnerable positions, attachment,
						mentalization, and collaboration between children, parents, and professionals.
					</p>
					<p>
						I offer workshops, supervision, facilitated parent evenings, and longer programmes tailored to
						the specific needs of each institution.
					</p>
					<p>Please feel free to contact me for a no-obligation conversation or a specific proposal.</p>
				</div>
			</section>

			<section class="contact-section" id="contact" aria-labelledby="contact-title">
				<div>
					<p class="eyebrow">Contact</p>
					<h2 id="contact-title">Feel free to get in touch</h2>
					<p>Please feel free to contact me for a no-obligation conversation or a specific proposal.</p>
				</div>
				<div class="contact-actions">
					<a class="button primary" href="tel:+4593901154">Call me</a>
					<a class="button secondary" href="mailto:kontaktmariabaad@gmail.com">Send email</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<p>Maria Baad</p>
			<p>Phone: <a href="tel:+4593901154">+45 93901154</a></p>
			<p>CVR: 45155099</p>
		</footer>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--paper: #faf6ef;
		--surface: #fffdf8;
		--ink: #1f2d2a;
		--muted: #5f6f69;
		--sage: #dce8df;
		--sage-soft: #edf4ee;
		--sage-dark: #31564e;
		--clay: #a95d4c;
		--clay-soft: #f2ddd5;
		--butter: #f2d88f;
		--sky: #d9e8ec;
		--rose: #ead7d3;
		--white: #fffdf8;
		--line: rgba(34, 48, 43, 0.14);
		--shadow: 0 22px 55px rgba(34, 48, 43, 0.1);
		--shadow-soft: 0 14px 32px rgba(34, 48, 43, 0.08);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; scroll-padding-top: 96px; }
	body { margin: 0; background: var(--paper); color: var(--ink); font-size: 16px; line-height: 1.6; }
	a { color: inherit; }
	:focus-visible { outline: 3px solid var(--clay); outline-offset: 4px; }

	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 100;
		transform: translateY(-140%);
		padding: 10px 14px;
		background: var(--ink);
		border-radius: 7px;
		color: var(--white);
		font-weight: 800;
		text-decoration: none;
		transition: transform 180ms ease;
	}

	.skip-link:focus-visible { transform: translateY(0); }

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 18px clamp(20px, 5vw, 72px);
		background:
			linear-gradient(180deg, rgba(237, 244, 238, 0.94), rgba(255, 253, 248, 0.9)),
			rgba(255, 253, 248, 0.9);
		border-bottom: 1px solid rgba(34, 48, 43, 0.18);
		box-shadow: 0 8px 22px rgba(34, 48, 43, 0.045);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
	.brand-mark {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(145deg, var(--sage-dark), #243e39);
		color: var(--white);
		font-weight: 700;
		box-shadow: var(--shadow-soft);
	}

	.brand strong, .brand small { display: block; }
	.brand small, .eyebrow { color: var(--muted); font-size: 0.84rem; font-weight: 700; text-transform: uppercase; }

	.header-tools { display: flex; align-items: center; gap: 18px; }
	.main-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 22px; font-size: 0.95rem; }
	.main-nav a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; text-underline-offset: 5px; white-space: nowrap; flex: 0 0 auto; }
	.main-nav a:hover, .main-nav a:focus-visible { color: var(--clay); }

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.language-switcher { position: relative; display: inline-flex; align-items: center; min-width: 138px; }
	.language-switcher::before {
		content: "";
		position: absolute;
		left: 13px;
		width: 18px;
		height: 14px;
		border: 1px solid rgba(52, 82, 74, 0.16);
		border-radius: 3px;
		background-color: #c60c30;
		background-image:
			linear-gradient(90deg, transparent 0 31%, #ffffff 31% 43%, transparent 43% 100%),
			linear-gradient(transparent 0 41%, #ffffff 41% 59%, transparent 59% 100%);
		box-shadow: 0 1px 2px rgba(31, 45, 42, 0.12);
		pointer-events: none;
	}
	.language-switcher[data-language="en"]::before {
		background-color: #0a3a8a;
		background-image:
			linear-gradient(90deg, transparent 0 43%, #ffffff 43% 57%, transparent 57% 100%),
			linear-gradient(transparent 0 43%, #ffffff 43% 57%, transparent 57% 100%),
			linear-gradient(90deg, transparent 0 46%, #c8102e 46% 54%, transparent 54% 100%),
			linear-gradient(transparent 0 46%, #c8102e 46% 54%, transparent 54% 100%),
			linear-gradient(33deg, transparent 0 41%, #ffffff 41% 48%, transparent 48% 52%, #ffffff 52% 59%, transparent 59% 100%),
			linear-gradient(-33deg, transparent 0 41%, #ffffff 41% 48%, transparent 48% 52%, #ffffff 52% 59%, transparent 59% 100%),
			linear-gradient(33deg, transparent 0 45%, #c8102e 45% 47.5%, transparent 47.5% 52.5%, #c8102e 52.5% 55%, transparent 55% 100%),
			linear-gradient(-33deg, transparent 0 45%, #c8102e 45% 47.5%, transparent 47.5% 52.5%, #c8102e 52.5% 55%, transparent 55% 100%);
	}
	.language-switcher::after {
		position: absolute;
		right: 14px;
		width: 7px;
		height: 7px;
		content: "";
		border-right: 1.8px solid currentColor;
		border-bottom: 1.8px solid currentColor;
		transform: translateY(-35%) rotate(45deg);
		color: var(--sage-dark);
		pointer-events: none;
	}

	.language-switcher select {
		width: 100%;
		min-height: 44px;
		padding: 10px 38px 10px 38px;
		border: 1px solid rgba(52, 82, 74, 0.16);
		border-radius: 7px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 252, 246, 0.96));
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.7) inset,
			0 10px 24px rgba(52, 82, 74, 0.08);
		color: var(--ink);
		font: inherit;
		font-weight: 600;
		letter-spacing: 0.01em;
		appearance: none;
		-webkit-appearance: none;
		-moz-appearance: none;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease,
			transform 0.2s ease;
	}

	.language-switcher select:hover {
		border-color: rgba(52, 82, 74, 0.26);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.72) inset,
			0 14px 26px rgba(52, 82, 74, 0.11);
	}

	.language-switcher select:focus-visible {
		outline: none;
		border-color: rgba(52, 82, 74, 0.34);
		box-shadow:
			0 0 0 4px rgba(108, 140, 128, 0.16),
			0 1px 0 rgba(255, 255, 255, 0.72) inset,
			0 14px 26px rgba(52, 82, 74, 0.12);
	}

	main { overflow: hidden; }
	.hero, .section, .quote-band, .contact-section, .site-footer { padding-inline: clamp(20px, 5vw, 72px); }

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.04fr) minmax(320px, 0.78fr);
		gap: clamp(36px, 7vw, 92px);
		align-items: center;
		min-height: min(780px, calc(100dvh - 82px));
		padding-block: clamp(58px, 8vw, 92px) clamp(44px, 6vw, 72px);
		background:
			linear-gradient(180deg, rgba(220, 232, 223, 0.62), rgba(250, 246, 239, 0) 34%),
			linear-gradient(115deg, rgba(220, 232, 223, 0.78), transparent 50%),
			linear-gradient(22deg, rgba(217, 232, 236, 0.56), transparent 44%),
			var(--paper);
	}

	.eyebrow { margin: 0 0 14px; letter-spacing: 0; }
	h1, h2, p { margin-top: 0; }
	h1, h2 { line-height: 1.08; letter-spacing: 0; }
	h1 {
		max-width: 880px;
		margin-bottom: 22px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.8rem, 6.7vw, 5.85rem);
		font-weight: 500;
	}
	h2 {
		max-width: 780px;
		margin-bottom: 20px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.15rem, 4.6vw, 4.6rem);
		font-weight: 500;
	}

	.hero-lede, .section p, .contact-section p {
		max-width: 680px;
		color: var(--muted);
		font-size: 1.08rem;
	}

	.hero-actions, .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
	.button, .quote-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 48px;
		padding: 13px 20px;
		border: 1px solid transparent;
		border-radius: 7px;
		font-weight: 800;
		text-decoration: none;
		box-shadow: 0 0 0 rgba(34, 48, 43, 0);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			background-color 180ms ease,
			border-color 180ms ease;
		touch-action: manipulation;
	}

	.button:hover, .quote-link:hover { transform: translateY(-2px); box-shadow: var(--shadow-soft); }
	.button.primary { background: var(--sage-dark); color: var(--white); }
	.button.secondary { background: var(--white); border-color: var(--line); color: var(--sage-dark); }

	.button.primary::after, .button.secondary::after, .quote-link::after {
		content: "";
		width: 0.58em;
		height: 0.58em;
		border-top: 2px solid currentColor;
		border-right: 2px solid currentColor;
		transform: rotate(45deg);
	}

	.trust-list { display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 0; padding: 0; list-style: none; }
	.trust-list li {
		padding: 9px 12px;
		background: rgba(255, 253, 248, 0.72);
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--sage-dark);
		font-size: 0.9rem;
		font-weight: 800;
	}

	.hero-media { min-width: 0; }
	.portrait-panel {
		position: relative;
		display: block;
		min-height: 560px;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		background: var(--sage);
		border: 1px solid var(--line);
		border-radius: 8px;
		box-shadow: var(--shadow);
	}

	.portrait-panel::before {
		position: absolute;
		inset: 0;
		z-index: 1;
		content: "";
		background:
			linear-gradient(180deg, rgba(31, 45, 42, 0.02) 45%, rgba(31, 45, 42, 0.34)),
			linear-gradient(120deg, rgba(255, 253, 248, 0.16), rgba(255, 253, 248, 0));
		pointer-events: none;
	}

	.portrait-panel img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: inherit;
		object-fit: cover;
		object-position: center;
	}

	.section { padding-block: clamp(70px, 10vw, 132px); }
	.prose-section {
		display: grid;
		grid-template-columns: minmax(0, 52rem);
		justify-content: center;
		gap: 24px;
		align-items: start;
	}

	.surface-section { background: #E1CCBE; }
	.section-heading, .prose-flow { max-width: 46rem; }
	.prose-flow p + p { margin-top: 18px; }
	.inline-link { color: var(--sage-dark); font-weight: 700; text-underline-offset: 4px; }

	.quote-band {
		display: grid;
		gap: 28px;
		padding-block: clamp(60px, 9vw, 112px);
		background: var(--sage-dark);
		color: var(--white);
	}

	.quote-band .eyebrow { color: var(--butter); }
	.quote-band h2 { margin-bottom: 0; color: var(--white); font-size: clamp(2rem, 4vw, 3.6rem); }
	.quote-band-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
	.quote-link { background: rgba(255, 253, 248, 0.08); border-color: rgba(255, 253, 248, 0.28); color: var(--white); }

	.featured-quote { margin: 0; max-width: 54rem; }
	.featured-quote p {
		margin: 0;
		color: var(--white);
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.4rem, 3vw, 2.3rem);
		line-height: 1.3;
	}

	.featured-quote cite {
		display: block;
		margin-top: 22px;
		color: rgba(255, 253, 248, 0.82);
		font-size: 1rem;
		font-style: normal;
		font-weight: 700;
	}

	.institution-section {
		padding-top: clamp(44px, 6vw, 72px);
		background: var(--sage-dark);
		color: var(--white);
	}

	.institution-section .eyebrow { color: var(--butter); }
	.institution-section h2, .institution-section p, .institution-section .inline-link { color: var(--white); }

	.contact-section {
		align-items: center;
		padding-block: clamp(56px, 8vw, 88px);
		background:
			linear-gradient(120deg, rgba(255, 253, 248, 0.45), transparent 58%),
			var(--butter);
	}

	.contact-section .button.secondary { background: transparent; border-color: rgba(34, 48, 43, 0.28); }

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px 24px;
		padding-block: 28px;
		background: var(--ink);
		color: var(--white);
	}

	.site-footer p { margin: 0; }
	.site-footer a { text-decoration-color: rgba(255, 253, 248, 0.5); text-underline-offset: 4px; }

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
		}
	}

	@media (max-width: 900px) {
		.site-header { align-items: flex-start; flex-direction: column; gap: 14px; }
		.header-tools { width: 100%; flex-direction: column; align-items: stretch; gap: 10px; }
		.main-nav {
			width: 100%;
			overflow-x: auto;
			flex-wrap: nowrap;
			justify-content: flex-start;
			padding-bottom: 2px;
			scrollbar-width: none;
		}

		.main-nav::-webkit-scrollbar { display: none; }
		.language-switcher { width: 100%; }
		.hero, .institution-section, .prose-section, .contact-section { grid-template-columns: 1fr; }
		.hero { min-height: auto; }
		.portrait-panel { min-height: 360px; aspect-ratio: 16 / 11; }
		.portrait-panel img { object-position: center 36%; }
		.quote-band-head { flex-direction: column; align-items: flex-start; }
	}

	@media (max-width: 560px) {
		.site-header, .hero, .section, .quote-band, .contact-section, .site-footer {
			padding-inline: 18px;
		}

		h1 { font-size: 2.5rem; }
		h2 { font-size: 2rem; }
		.hero-lede, .section p, .contact-section p, .featured-quote cite { font-size: 1rem; }
		.hero-actions, .contact-actions { align-items: stretch; flex-direction: column; }
		.button, .quote-link { width: 100%; }
	}
</style>
